# PHUZZ scoring mode switch.
# 1 = original PHUZZ only.
# 2 = PHUZZ + hook coverage feedback.
PHUZZ_SCORING_MODE=2

# Hook request artifact directory inside the fuzzer container.
# The fuzzer matches these request JSON files to candidates through X-FUZZER-COVID / coverage_id.
FUZZER_HOOK_REQUESTS_DIR=/shared-tmpfs/hook-coverage/requests

# Weight added to candidate priority from hook_energy.
# Formula: final_priority = base_priority + (hook_energy * FUZZER_HOOK_PRIORITY_WEIGHT).
FUZZER_HOOK_PRIORITY_WEIGHT=1.0

# Base-share weight for the weighted hook-energy blend.
# Formula:
# final_energy = ceil(
#   (base_energy * FUZZER_HOOK_ENERGY_BASE_WEIGHT)
#   + (hook_energy * (1 - FUZZER_HOOK_ENERGY_BASE_WEIGHT) * max(FUZZER_HOOK_MIN_ENERGY_SCALE, base_energy))
# )
FUZZER_HOOK_ENERGY_BASE_WEIGHT=0.8

# Minimum hook scale used when PHUZZ base energy is small.
FUZZER_HOOK_MIN_ENERGY_SCALE=4

# Deprecated fallback alias for older configs.
# Only used when FUZZER_HOOK_ENERGY_BASE_WEIGHT is unset.
# FUZZER_HOOK_ENERGY_WEIGHT=0.8

# Verbose score calculation logs.
# 0 = off. 1 = print path/line scoring details from calculate_score().
PHUZZ_SCORE_DEBUG=0

# Per-request runtime trace.
# 0 = off. 1 = print one log line per outgoing fuzz request with method, URL, mutated param, status, and body length.
PHUZZ_TRACE_REQUESTS=1
