FROM php:8.2.10-apache AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends $PHPIZE_DEPS \
    && pecl channel-update pecl.php.net \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/hookphuzz_opcode_phase9
COPY research/hookphuzz-opcode/phase9/extension/ ./
RUN phpize \
    && ./configure --enable-hookphuzz_opcode_phase9 \
    && make -j"$(nproc)" \
    && make install

FROM php:8.2.10-apache

RUN apt-get update && \
    apt-get install -y --no-install-recommends vim git wget rsync default-mysql-client libpng-dev icu-devtools libicu-dev libjpeg-dev graphicsmagick-libmagick-dev-compat libzip-dev sudo less curl iputils-ping dnsutils zip

RUN docker-php-ext-configure bcmath
RUN docker-php-ext-configure exif
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp
RUN docker-php-ext-configure intl
RUN docker-php-ext-configure pdo_mysql
RUN docker-php-ext-configure mysqli
RUN docker-php-ext-configure zip
RUN docker-php-ext-install -j "$(nproc)" bcmath exif gd intl pdo_mysql mysqli zip opcache

WORKDIR /var/www/

RUN pecl install uopz-7.1.1
RUN pecl install xdebug
RUN pecl install pcov

RUN rm /bin/sh && ln -s bash /bin/sh

COPY --from=build /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY phuzz-main/code/web/configs/php.ini "$PHP_INI_DIR/php.ini"
COPY phuzz-main/code/web/configs/mpm_prefork.conf /etc/apache2/mods-available/mpm_prefork.conf
COPY phuzz-main/code/web/instrumentation/ /var/www/fuzzer/
COPY phuzz-main/code/web/entrypoint.sh /
RUN mkdir -p /shared/opcode-events \
    && chown -R www-data:www-data /shared \
    && printf 'extension=hookphuzz_opcode_phase9.so\nhookphuzz_opcode.target_callbacks=\nhookphuzz_opcode.target_callbacks_file=/shared/phase9-callback-registry.json\n' > "$PHP_INI_DIR/conf.d/50-hookphuzz-opcode-phase9.ini"

COPY --from=composer:latest@sha256:1ac7a547cb88acb0de62663b70f2b3d80ad27355288245159404b6ae40cd9ca3 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html/
ENTRYPOINT ["/entrypoint.sh"]

CMD ["/usr/sbin/apache2ctl", "-D", "FOREGROUND"]
