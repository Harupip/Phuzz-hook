# Per-candidate online discovery timeout in seconds.
ONLINE_TIMEOUT_SECONDS=120

# Max config versions per candidate, including v0.
ONLINE_MAX_VERSIONS=2

# Max candidates per online-linked campaign.
ONLINE_MAX_CANDIDATES=32

# Total online-linked campaign timeout in seconds.
ONLINE_CAMPAIGN_TIMEOUT_SECONDS=3600

# Stop after this many vulnerability findings; 0 keeps fuzzing.
HOOKPHUZZ_STOP_ON_VULN=0

# Ask to compare one final config after online-linked finishes (interactive terminal only).
# 1 enables the prompt; 0 disables it.
ONLINE_COMPARE_PROMPT=1
