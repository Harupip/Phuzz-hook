# PHUZZ scoring mode switch.
# 1 = original PHUZZ only.
# 2 = PHUZZ + hook coverage bonus.
PHUZZ_SCORING_MODE=2

# Hook request artifact directory inside the fuzzer container.
# The fuzzer matches these request JSON files to candidates through X-FUZZER-COVID / coverage_id.
FUZZER_HOOK_REQUESTS_DIR=/shared-tmpfs/hook-coverage/requests

# Weight added to candidate priority from hook_energy.
# Formula: final_priority = base_priority + (hook_energy * FUZZER_HOOK_PRIORITY_WEIGHT).
FUZZER_HOOK_PRIORITY_WEIGHT=1.0

# Weight added to candidate mutation budget from hook_energy.
# Formula: final_energy = base_energy + ceil(hook_energy * FUZZER_HOOK_ENERGY_WEIGHT).
FUZZER_HOOK_ENERGY_WEIGHT=1.0

# Verbose score calculation logs.
# 0 = off. 1 = print path/line scoring details from calculate_score().
PHUZZ_SCORE_DEBUG=0
